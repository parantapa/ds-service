Bootstrap: docker
From: ubuntu:26.04
Stage: build

%files
    ./profiles-default /opt/conan_home/profiles/default

%post
    export LC_ALL=C
    export DEBIAN_FRONTEND=noninteractive
    export CONAN_HOME=/opt/conan_home

    apt-get -y update \
        && apt-get install -y --no-install-recommends \
            build-essential git cmake \
            python3 python3-pip python-is-python3

    pip install \
        --root-user-action=ignore \
        --break-system-packages \
        --no-cache-dir \
        conan

    cd /opt
    git clone https://github.com/parantapa/ds-service.git
    cd ds-service
    git checkout v1.0.1

    conan install . --build=missing
    BUILD_DIR="./build/Release"

    cmake -S . -B "$BUILD_DIR" \
        -DCMAKE_CXX_FLAGS="-Wall -Wextra" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_TOOLCHAIN_FILE="generators/conan_toolchain.cmake"

    cmake --build "$BUILD_DIR" --parallel
    cmake --install "$BUILD_DIR" --prefix /usr

Bootstrap: docker
From: ubuntu:26.04
Stage: final

%files from build
    /usr/bin/ds-service /usr/bin/ds-service

%environment
    export LC_ALL=C

%runscript
    ds-service "$@"

%labels
    Author parantapa@virginia.edu

%help
    Container for ds-service.

